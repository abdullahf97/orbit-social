# ---------------------------------------------------------------------------
# Orbit environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Docker locally, Neon in production).
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"

# Public origin, used for origin checks and absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage adapter: "local" writes to ./public/uploads (dev only).
# Leave unset on Vercel and provide BLOB_READ_WRITE_TOKEN to use Vercel Blob.
STORAGE_DRIVER="local"

# Only needed when STORAGE_DRIVER=vercel-blob (auto-injected on Vercel).
# BLOB_READ_WRITE_TOKEN=""

# Seed script demo password (defaults to "orbitdemo").
SEED_PASSWORD="orbitdemo"
